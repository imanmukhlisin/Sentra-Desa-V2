sentra_desa/.pub/
sentra_desa/build/
sentra_desa/coverage/
sentra_desa/.packages
sentra_desa/pubspec.lock

# Flutter generated files
sentra_desa/android/app/debug/
sentra_desa/android/app/profile/
sentra_desa/android/app/release/
sentra_desa/android/.gradle/
sentra_desa/android/local.properties
sentra_desa/android/key.properties
sentra_desa/android/app/src/main/res/values/styles.xml.bak
sentra_desa/ios/Flutter/.last_build_id
sentra_desa/ios/Pods/
sentra_desa/ios/.symlinks/
sentra_desa/macos/Pods/
sentra_desa/macos/.symlinks/

