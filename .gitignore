# ============================================
# SENTRA DESA — Root .gitignore
# Stack: Laravel (Backend) + Next.js (Frontend)
# ============================================

# =============  OS & System  ================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# =============  IDEs & Editors  =============
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Sublime / Vim / Agent tools
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.antigravity/
.gemini/
AGENTS.md
CLAUDE.md
deploy*.sh
deploy*.ps1

# =============  Environment & Secrets  =======
.env
.env.*
!.env.example
!.env.*.example

# =============  Laravel Backend  ============
sentra-desa-backend/.env
sentra-desa-backend/.env.*
!sentra-desa-backend/.env.example
sentra-desa-backend/vendor/
sentra-desa-backend/node_modules/
sentra-desa-backend/public/hot
sentra-desa-backend/public/storage
sentra-desa-backend/public/build/
sentra-desa-backend/storage/*.key
sentra-desa-backend/storage/framework/cache/data/*
sentra-desa-backend/storage/framework/sessions/*
sentra-desa-backend/storage/framework/testing/*
sentra-desa-backend/storage/framework/views/*
sentra-desa-backend/storage/logs/*
sentra-desa-backend/bootstrap/cache/*
!sentra-desa-backend/bootstrap/cache/.gitkeep
sentra-desa-backend/.phpunit.result.cache
sentra-desa-backend/.phpunit.cache/
sentra-desa-backend/auth.json
sentra-desa-backend/coverage/

# =============  Next.js Frontend  ===========
sentra-desa-frontend/.next/
sentra-desa-frontend/out/
sentra-desa-frontend/node_modules/
sentra-desa-frontend/.env
sentra-desa-frontend/.env.*
!sentra-desa-frontend/.env.example
sentra-desa-frontend/*.tsbuildinfo
sentra-desa-frontend/.vercel/
sentra-desa-frontend/.turbo/

# =============  General Dependencies & Build  =
node_modules/
vendor/
.next/
out/
dist/

# =============  Logs & Temporary Artifacts  ==
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

*.bak
*.tmp
*.temp
*.sqlite
*.class
*.pyc
*.o
*.so
*.dll
